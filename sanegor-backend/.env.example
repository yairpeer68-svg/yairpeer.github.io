# ======================================================================
# סנגור (Sanegor) — Backend configuration
# Copy to .env and fill in real values. NEVER commit the real .env file.
# ======================================================================

# ---------- General ----------
APP_NAME="Sanegor Legal AI"
ENVIRONMENT=development           # development | staging | production
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false                    # true in production

# Comma separated. In production list your real origins only — never "*".
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Comma separated hostnames accepted by the TrustedHost middleware.
ALLOWED_HOSTS=*

# Force HTTPS redirects + HSTS. MUST be true in production.
FORCE_HTTPS=false

# ---------- Database ----------
POSTGRES_USER=sanegor
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=sanegor
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Optional full override; if empty it is assembled from the parts above.
DATABASE_URL=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ---------- Redis ----------
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=900

# ---------- Security ----------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-generate-a-64-byte-random-string
# Fernet key for encryption at rest of document text.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_MIN_LENGTH=10

# Rate limits (requests per window, per identity+route-group).
RATE_LIMIT_DEFAULT=120/60         # 120 requests / 60 seconds
RATE_LIMIT_AUTH=10/60
RATE_LIMIT_AI=30/60
RATE_LIMIT_UPLOAD=20/300

# ---------- OAuth (optional) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ---------- DeepSeek ----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=120
DEEPSEEK_MAX_TOKENS=4096
DEEPSEEK_TEMPERATURE=0.2
# Total prompt budget (tokens) the context builder may fill.
AI_CONTEXT_TOKEN_BUDGET=48000

# ---------- Embeddings ----------
# openai_compatible = any server exposing POST {base_url}/embeddings
#                     (TEI, Ollama, vLLM, LiteLLM proxy, ...).
# hashing           = deterministic local fallback, dev/tests only.
EMBEDDING_PROVIDER=hashing
EMBEDDING_BASE_URL=http://embeddings:8080/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIMENSIONS=1024

# ---------- RAG ----------
RAG_ENABLED=true
RAG_TOP_K=24                      # candidates pulled from the vector index
RAG_FINAL_K=6                     # chunks that actually enter the prompt
RAG_MIN_SCORE=0.25                # below this a chunk is discarded entirely
RAG_CHUNK_TOKENS=700
RAG_CHUNK_OVERLAP_TOKENS=100

# ---------- Uploads ----------
STORAGE_DIR=/var/lib/sanegor/storage
MAX_UPLOAD_MB=25
ALLOWED_UPLOAD_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain,image/jpeg,image/png

# ---------- OCR ----------
OCR_ENABLED=true
OCR_LANGUAGES=heb+eng
TESSERACT_CMD=/usr/bin/tesseract

# ---------- Celery (optional; falls back to FastAPI BackgroundTasks) ----------
CELERY_ENABLED=false
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---------- Bootstrap ----------
# If set, an admin user is created/promoted on first start.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
