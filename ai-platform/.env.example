APP_ENV=development
APP_NAME=AI Platform
APP_HOST=0.0.0.0
APP_PORT=8080
APP_VERSION=2.1.1
GIT_COMMIT=dev
BUILD_TIME=unknown
DATABASE_URL=postgresql+asyncpg://ai_platform:CHANGE_ME@postgres:5432/ai_platform
POSTGRES_DB=ai_platform
POSTGRES_USER=ai_platform
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
REDIS_URL=redis://redis:6379/0
JWT_SECRET=CHANGE_ME_64_RANDOM_CHARS_MINIMUM
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_ALLOWED_MODELS=deepseek-chat,deepseek-reasoner
AI_PROVIDER_MODE=deepseek
DEEPSEEK_TIMEOUT_SECONDS=45
DEEPSEEK_MAX_RETRIES=3
CORS_ORIGINS=http://localhost:5173
TRUSTED_HOSTS=localhost,127.0.0.1
AI_RATE_LIMIT_PER_MINUTE=20
AUTH_RATE_LIMIT_PER_MINUTE=10
ADMIN_RATE_LIMIT_PER_MINUTE=60
AI_CACHE_TTL_SECONDS=300
AI_MAX_PROMPT_CHARS=20000
AI_MAX_RESPONSE_TOKENS=4096
AI_GLOBAL_MAX_RESPONSE_TOKENS=8192
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=
LOG_LEVEL=INFO
SENTRY_DSN=
PROMETHEUS_ENABLED=true
METRICS_TOKEN=
BACKUP_RETENTION_DAYS=14
AUDIT_RETENTION_DAYS=365
AI_METADATA_RETENTION_DAYS=90
PROMPT_LOGGING_ENABLED=false
PROMPT_RETENTION_ENCRYPTION_KEY=
PLAY_INTEGRITY_PROJECT_NUMBER=
PLAY_INTEGRITY_CREDENTIALS_JSON=
FCM_CREDENTIALS_JSON=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
PAYMENT_PROVIDER=mock
APP_BASE_URL=https://example.com
ANDROID_API_BASE_URL=https://example.com/api/v1
CERT_PINNING_ENABLED=false
CERT_PIN_SHA256_CURRENT=
CERT_PIN_SHA256_NEXT=

# Autonomous engineering runtime
ENGINEERING_ENABLED=true
ENGINEERING_WORKSPACE_ROOT=/workspaces
ENGINEERING_MAX_PROJECT_FILES=5000
ENGINEERING_MAX_ARCHIVE_BYTES=100000000
ENGINEERING_MAX_EXTRACTED_BYTES=500000000
ENGINEERING_MAX_FILE_BYTES=2000000
ENGINEERING_COMMAND_TIMEOUT_SECONDS=180
ENGINEERING_RUNNER_CONCURRENCY=3
ENGINEERING_MAX_REPAIR_ATTEMPTS=3
ENGINEERING_AUTO_EXECUTE_COMMANDS=false
ENGINEERING_RUNNER_URL=http://runner:8090
ENGINEERING_RUNNER_TOKEN=CHANGE_ME_STRONG_RUNNER_TOKEN_AT_LEAST_32_CHARS
ENGINEERING_ALLOW_LOCAL_EXECUTION=false
ENGINEERING_ALLOWED_COMMANDS=python,python3,pytest,ruff,mypy,git,npm,npx,node,dart,flutter,gradle,./gradlew

# Nginx must accept at least ENGINEERING_MAX_ARCHIVE_BYTES, otherwise archive uploads are
# rejected at the gateway with 413 before the API ever sees them. Keep these two in sync;
# CI asserts the relationship.
ENGINEERING_MAX_ARCHIVE_MB=100

# A required build gate whose toolchain is absent from the runner image is reported as
# toolchain_missing. false = the run continues with the gate marked unverified;
# true = a missing toolchain fails the run. The stock runner image ships Python and Node
# only, so leaving this true makes every Flutter/Gradle project fail. Build
# runner/Dockerfile.flutter and set this to true when those gates must be authoritative.
ENGINEERING_STRICT_TOOLCHAINS=false

# Per-account ceilings for the engineering runtime.
ENGINEERING_MAX_WORKSPACE_BYTES=2000000000
ENGINEERING_MAX_PROJECTS_PER_USER=20
ENGINEERING_MAX_ACTIVE_RUNS_PER_USER=2
ENGINEERING_RUN_TIMEOUT_SECONDS=3600

# Interval for the retention sweep run by the scheduler service.
RETENTION_SWEEP_INTERVAL_SECONDS=86400

# Isolated runner resource ceilings.
RUNNER_DOCKERFILE=Dockerfile
RUNNER_MEM_LIMIT=4g
RUNNER_CPUS=2.0
RUNNER_MEMORY_LIMIT_BYTES=3221225472
RUNNER_CPU_SECONDS=600
API_MEM_LIMIT=1g
WORKER_MEM_LIMIT=1g

# Set to the Nginx service/host that fronts the API. "*" would let any peer that can
# reach the API spoof X-Forwarded-For and defeat per-IP rate limiting.
FORWARDED_ALLOW_IPS=nginx

# Set to 0 to take database-only backups. Leave at 1 so scripts/backup.sh also captures
# the engineering workspace volume; without it a restore has no project files.
BACKUP_WORKSPACES=1
