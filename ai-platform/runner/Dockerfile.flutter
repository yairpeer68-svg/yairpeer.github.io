# Opt-in runner image with the Flutter/Dart/Android toolchain.
#
# The default runner ships Python and Node only, so `flutter analyze`, `flutter test`
# and `./gradlew test` report as toolchain_missing. Build this image instead when the
# platform must verify Flutter or Android projects:
#
#   docker compose build --build-arg RUNNER_DOCKERFILE=Dockerfile.flutter runner
#   # or set: services.runner.build.dockerfile: Dockerfile.flutter
#
# It is a multi-GB image; that is why it is not the default.
FROM python:3.12.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
ENV FLUTTER_VERSION=3.27.1 ANDROID_SDK_ROOT=/opt/android-sdk FLUTTER_HOME=/opt/flutter
ENV PATH="${FLUTTER_HOME}/bin:${FLUTTER_HOME}/bin/cache/dart-sdk/bin:${ANDROID_SDK_ROOT}/cmdline-tools/latest/bin:${ANDROID_SDK_ROOT}/platform-tools:${PATH}"

RUN groupadd --gid 10001 runner && useradd --uid 10001 --gid runner --create-home runner \
 && apt-get update && apt-get install -y --no-install-recommends \
      git curl unzip xz-utils zip ca-certificates nodejs npm openjdk-17-jdk-headless \
 && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL "https://storage.googleapis.com/flutter_infra_release/releases/stable/linux/flutter_linux_${FLUTTER_VERSION}-stable.tar.xz" \
      -o /tmp/flutter.tar.xz \
 && tar -xJf /tmp/flutter.tar.xz -C /opt && rm /tmp/flutter.tar.xz \
 && git config --system --add safe.directory "${FLUTTER_HOME}"

RUN mkdir -p "${ANDROID_SDK_ROOT}/cmdline-tools" \
 && curl -fsSL https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip -o /tmp/tools.zip \
 && unzip -q /tmp/tools.zip -d "${ANDROID_SDK_ROOT}/cmdline-tools" && rm /tmp/tools.zip \
 && mv "${ANDROID_SDK_ROOT}/cmdline-tools/cmdline-tools" "${ANDROID_SDK_ROOT}/cmdline-tools/latest" \
 && yes | sdkmanager --licenses >/dev/null \
 && sdkmanager --install "platform-tools" "platforms;android-35" "build-tools;35.0.0" >/dev/null

WORKDIR /runner
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt pytest ruff mypy
COPY runner.py ./

RUN chown -R 10001:10001 "${FLUTTER_HOME}" "${ANDROID_SDK_ROOT}"
USER 10001:10001
RUN flutter --version && flutter precache --android >/dev/null
EXPOSE 8090
CMD ["uvicorn","runner:app","--host","0.0.0.0","--port","8090","--no-access-log"]
