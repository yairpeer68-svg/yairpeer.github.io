#!/usr/bin/env sh
set -eu
DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
VERSION=8.7
CACHE="${GRADLE_USER_HOME:-$HOME/.gradle}/manual-wrapper/gradle-$VERSION"
GRADLE="$CACHE/bin/gradle"
if [ ! -x "$GRADLE" ]; then
  ZIP="${TMPDIR:-/tmp}/gradle-$VERSION-bin.zip"
  mkdir -p "$(dirname "$CACHE")"
  if command -v curl >/dev/null 2>&1; then curl -fL "https://services.gradle.org/distributions/gradle-$VERSION-bin.zip" -o "$ZIP";
  elif command -v wget >/dev/null 2>&1; then wget -O "$ZIP" "https://services.gradle.org/distributions/gradle-$VERSION-bin.zip";
  else echo "curl or wget is required for first Gradle bootstrap" >&2; exit 1; fi
  unzip -q -o "$ZIP" -d "$(dirname "$CACHE")"
  rm -f "$ZIP"
fi
exec "$GRADLE" -p "$DIR" "$@"
