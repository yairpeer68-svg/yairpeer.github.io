    <!-- מדריך פתיחה -->
    <string name="onb_welcome_title">ברוך הבא לשומר הברית</string>
    <string name="onb_welcome_body">כלי לשמירה על גלישה נקייה — שאתה מתקין על עצמך, מרצון, כחלק מברית אישית. השלבים הבאים יסבירו כל הרשאה לפני שתאשר אותה.</string>
    <string name="onb_perm_notif_title">התראות</string>
    <string name="onb_perm_notif_body">כדי שההגנה תוכל להציג סטטוס ולהתריע לשותף האחריות.</string>
    <string name="onb_perm_overlay_title">הצגה מעל אפליקציות</string>
    <string name="onb_perm_overlay_body">נדרש כדי להציג את מסך החסימה מעל תוכן לא ראוי. בלי זה החסימה לא תעבוד.</string>
    <string name="onb_perm_vpn_title">סינון רשת (VPN מקומי)</string>
    <string name="onb_perm_vpn_body">VPN שרץ רק על המכשיר — לא מוציא את הנתונים שלך החוצה. חוסם תוכן ברמת הרשת.</string>
    <string name="onb_perm_usage_title">נתוני שימוש</string>
    <string name="onb_perm_usage_body">כדי לעקוב אחרי זמן מסך ולאכוף לוחות זמנים שאתה מגדיר.</string>
    <string name="onb_perm_battery_title">פטור מחיסכון סוללה</string>
    <string name="onb_perm_battery_body">כדי שההגנה לא תיעצר ברקע. במיוחד חשוב בשיאומי/וואן פלוס/סמסונג.</string>
    <string name="onb_perm_admin_title">מנהל מכשיר</string>
    <string name="onb_perm_admin_body">מקשה על הסרת האפליקציה ברגע של חולשה. אפשר להסיר תמיד עם קוד הברית.</string>
    <string name="onb_perm_accessibility_title">שירות נגישות</string>
    <string name="onb_perm_accessibility_body">ליבת הסינון — קורא את מה שמוצג על המסך כדי לחסום תוכן. אחרון, כי ממנו ההגנה מתחילה לפעול.</string>
    <string name="onb_grant">הענק הרשאה</string>
    <string name="onb_granted">✓ הוענק</string>
    <string name="onb_skip">דלג בינתיים</string>
    <string name="onb_finish">סיימתי — הפעל הגנה</string>
    <string name="onb_transparency">שקיפות: זהו כלי אחריות שאתה מתקין על עצמך. הוא נועד לעזור למי שרוצה עזרה, לא לרגל אחרי אף אחד.</string>
    <string name="onb_required">🔒 הרשאה זו חובה. בלעדיה ההגנה חלקית — הפעל אותה כדי להמשיך.</string>
    <string name="onb_required_badge">חובה</string>
    <string name="onb_optional_badge">מומלץ</string>
    <string name="onb_how_title">איך זה עובד</string>
    <string name="onb_how_body">שומר הברית מגן בשלוש שכבות בו-זמנית:\n\n• סינון רשת (VPN מקומי) — חוסם אתרים ותוכן כבר ברמת החיבור, כולל אכיפת חיפוש בטוח.\n\n• שירות נגישות — קורא את מה שמוצג ומקליד, וחוסם תוכן לא ראוי בכל אפליקציה ודפדפן.\n\n• הגנה עצמית — חוסם ניסיונות להסיר את האפליקציה, לבטל הרשאות, או להפעיל VPN אחר שיעקוף את הסינון.\n\nכדי שהכל יעבוד במלואו צריך להפעיל את כל ההרשאות המסומנות \"חובה\". נלווה אותך שלב-אחר-שלב.</string>
    <string name="onb_done_title">ההגנה פעילה ✓</string>
    <string name="onb_done_body">כל ההרשאות ההכרחיות מופעלות. מעכשיו:\n\n• תוכן לא ראוי ייחסם אוטומטית בכל האפליקציות.\n• ניסיון לעקוף, להסיר, או לכבות את ההגנה — ייחסם וידרוש את קוד הברית.\n• קוד הברית הוא המפתח היחיד לשינוי הגדרות או להסרה. שמור עליו, ושקול לתת עותק לשותף אחריות.\n\nחזק ואמץ. אתה לא לבד בזה.</string>
    <string name="onb_missing">יש להפעיל את כל ההרשאות המסומנות \"חובה\" כדי לסיים.</string>

