#!/usr/bin/env bash
# ============================================================================
# Personal build helper.
#
#   cp scripts/run-local.sh.example scripts/run-local.sh
#   # put your key in the copy, then:
#   ./scripts/run-local.sh run     # run on a connected device
#   ./scripts/run-local.sh apk     # build an installable APK
#
#   # against a backend on this machine, over WiFi:
#   API_BASE_URL=http://192.168.1.20:8000 ./scripts/run-local.sh run
#
# scripts/run-local.sh is gitignored, so the key stays on your machine.
#
# The key ends up as a plain string inside the APK, which is fine for a build
# only you install and wrong for one you hand to other people. When you
# distribute, drop the key here and let each user enter their own in the app's
# settings screen.
# ============================================================================
set -euo pipefail

DEEPSEEK_API_KEY="sk-your-key-here"

# Backend address. Override for a LAN server:
#   10.0.2.2       the host machine, as seen from an Android emulator
#   192.168.x.x    this machine's LAN address, for a real phone on the WiFi
# Ignored entirely while the app runs in server-less mode.
API_BASE_URL="${API_BASE_URL:-http://10.0.2.2:8000}"

# Cleartext HTTP to a LAN address only works in a debug build; the release
# build refuses plain HTTP to anything but loopback. Use `run` or a debug APK
# when pointing at a development machine.

cd "$(dirname "${BASH_SOURCE[0]}")/.."

DEFINES=(
  --dart-define=DEEPSEEK_API_KEY="$DEEPSEEK_API_KEY"
  --dart-define=API_BASE_URL="$API_BASE_URL"
)

case "${1:-run}" in
  run)   flutter run "${DEFINES[@]}" ;;
  apk)   flutter build apk --release --split-per-abi "${DEFINES[@]}"
         echo "APK: build/app/outputs/flutter-apk/" ;;
  aab)   flutter build appbundle --release "${DEFINES[@]}" ;;
  *)     echo "usage: $0 [run|apk|aab]" >&2; exit 1 ;;
esac
